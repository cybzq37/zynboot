# ──────────────────────────────────────────────────────────────
# PostgreSQL (含 PostGIS + BM25 全文搜索 + TimescaleDB)
# ──────────────────────────────────────────────────────────────

# 基于 ParadeDB 镜像 + TimescaleDB 扩展
# 构建: cd deploy/middleware && docker compose build postgres
# 镜像: paradedb/paradedb:16 + postgresql-16-timescaledb-tsl
# 备选（不构建，直接拉取）:
#POSTGRES_IMAGE=paradedb/paradedb:16
#POSTGRES_IMAGE=timescale/timescaledb-ha:pg16

# ──────────────────────────────────────────────────────────────
# 统一密码
# ──────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=Zyn@secure#99
REDIS_PASSWORD=Zyn@secure#99
ELASTIC_PASSWORD=Zyn@secure#99
S3_ACCESS_KEY=zynex
S3_SECRET_KEY=Zyn@secure#99

# ──────────────────────────────────────────────────────────────
# SeaweedFS (S3)
# ──────────────────────────────────────────────────────────────

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=zyn
